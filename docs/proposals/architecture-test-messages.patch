diff --git a/tests/StoreOps.Api.Tests/Architecture/RuleAssert.cs b/tests/StoreOps.Api.Tests/Architecture/RuleAssert.cs
new file mode 100644
index 0000000..44361d2
--- /dev/null
+++ b/tests/StoreOps.Api.Tests/Architecture/RuleAssert.cs
@@ -0,0 +1,31 @@
+using Xunit.Sdk;
+
+namespace StoreOps.Api.Tests.Architecture;
+
+/// <summary>
+/// Fails an architecture test with a message the generator can act on without reading the test: the rule and
+/// gate IDs, every violation in full (xUnit truncates collection output), and how to fix it.
+/// </summary>
+internal static class RuleAssert
+{
+    public static void NoViolations(string rule, string fix, IReadOnlyCollection<string> violations)
+    {
+        if (violations.Count == 0)
+        {
+            return;
+        }
+
+        throw new XunitException(
+            $"[{rule}] {violations.Count} violation(s):{Environment.NewLine}"
+            + string.Join(Environment.NewLine, violations.Select(v => $"  - {v}"))
+            + $"{Environment.NewLine}Fix: {fix}");
+    }
+
+    public static void NoCycle(string rule, string fix, string? cycle)
+    {
+        if (cycle is not null)
+        {
+            throw new XunitException($"[{rule}] module cycle: {cycle}{Environment.NewLine}Fix: {fix}");
+        }
+    }
+}
